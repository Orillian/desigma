<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>desigma</string>
  <key>CFBundleDisplayName</key>
  <string>desigma</string>
  <key>CFBundleIdentifier</key>
  <string>ai.deepfounder.desigma</string>
  <key>CFBundleExecutable</key>
  <string>desigma</string>
  <key>CFBundleIconFile</key>
  <string>desigma</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@BUNDLE_VERSION@</string>
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.graphics-design</string>
  <key>NSHumanReadableCopyright</key>
  <string>MIT OR Apache-2.0, desigma contributors</string>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>desigma session link</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>desigma</string>
      </array>
    </dict>
  </array>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>desigma document</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>ai.deepfounder.desigma.document</string>
      </array>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>desigma</string>
      </array>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Figma design file</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.figma.document</string>
      </array>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>fig</string>
      </array>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
    </dict>
  </array>
  <!-- macOS 11+ resolves documents through UTIs: without these declarations a .desigma file
       gets a dyn.* type and cannot be opened from Finder (#29). -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>ai.deepfounder.desigma.document</string>
      <key>UTTypeDescription</key>
      <string>desigma document</string>
      <key>UTTypeIconFile</key>
      <string>desigma</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.content</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>desigma</string>
        </array>
      </dict>
    </dict>
  </array>
  <!-- Imported, not exported: Figma owns the .fig type; when Figma is installed its
       declaration wins and this one only fills in when it is not. -->
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.figma.document</string>
      <key>UTTypeDescription</key>
      <string>Figma design file</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.content</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>fig</string>
        </array>
        <key>public.mime-type</key>
        <string>application/x-figma</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
